# Belfort engine configuration
# Copy to .env and fill in values

# TA-Lib native library path (needed when installed locally without sudo)
# If you installed ta-lib to ~/.local, set:
# LD_LIBRARY_PATH=~/.local/lib:$LD_LIBRARY_PATH

# Data storage root (default: ~/.belfort)
# BELFORT_DATA_DIR=~/.belfort

# Exchange (default: binance — public REST, no key needed)
# BELFORT_EXCHANGE=binance

# Timeframes to analyse (comma-separated)
# BELFORT_TIMEFRAMES=1h,4h,1D

# Default symbols for multi-symbol commands
# BELFORT_SYMBOLS=BTCUSDT

# DuckDB results database path
# BELFORT_DB_PATH=~/.belfort/results.duckdb

# API server (default port 8000 matches frontend NEXT_PUBLIC_API_BASE)
# BELFORT_API_HOST=0.0.0.0
# BELFORT_API_PORT=8000

# --- Sentiment (F2) ---
# Reddit API: https://www.reddit.com/prefs/apps (script app)
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=belfort-sentiment/0.1 by yourusername

# RSS feeds (comma-separated)
# SENTIMENT_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss

# SENTIMENT_CACHE_TTL_SECONDS=900
# REDDIT_POST_LIMIT=25

# Optional APIs
# LUNARCRUSH_API_KEY=
# SANBASE_API_KEY=

# --- News (F3) — CryptoPanic ---
# https://cryptopanic.com/developers/api/
# CRYPTOPANIC_API_TOKEN=
# BELFORT_NEWS_CACHE_TTL=300

# Worker poll interval in seconds
# BELFORT_WORKER_POLL_SECONDS=2

# Minimum trades for a backtest result to be considered valid
# BELFORT_BT_MIN_TRADES=10
